# Copy to .env (this file is gitignored — see the root .gitignore's
# `.env`/`.env.*` patterns; `evals/.env` matches them exactly like this
# `.env.example` file itself matches the `!.env.example` exception).
#
# Loaded automatically, once per CLI invocation, by `evals.cli.main`'s
# `_load_env_file()` via python-dotenv — no manual `export`/`source`
# needed. Any variable already set in the real process environment (a
# CI secret, an explicit `export`) always wins over what's set here;
# this file is a local-dev convenience only, never a requirement.

# Anthropic direct API — used by `evals run --llm-judge` (single-judge
# mode, DEFAULT_JUDGE_MODEL).
ANTHROPIC_API_KEY=

# OpenAI direct API — `make_openai_call_model()` exists in
# judge/providers.py but nothing in this codebase calls it today (the
# panel moved to Bedrock, see docs/rfcs/2026-09-08-evals-judge-panel-
# reducer.md's revision). Only needed if you wire up your own caller.
OPENAI_API_KEY=

# AWS Bedrock — used by `evals run --llm-judge-panel` (Claude Sonnet 5 +
# Haiku 4.5, both served via Bedrock's Converse API). Standard boto3
# credential-chain variable names; a shared credentials file or an IAM
# role work too and don't need this file at all.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
# AWS_SESSION_TOKEN=   # optional, only for temporary/STS credentials
